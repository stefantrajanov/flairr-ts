# ──────────────────────────────────────────────────────────────────────────────
# FLAIRR-TS Environment Configuration
#
# Setup (uv):
#   uv sync                   # creates .venv and installs all deps from pyproject.toml
#   uv sync --extra dev       # also installs pytest / ruff
#   cp .env.example .env      # then fill in your values
#   uv run main.py --help     # run via uv (picks up .env automatically)
#
# Copy this file to .env and populate with your credentials.
# ──────────────────────────────────────────────────────────────────────────────

# Anthropic API key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model selection (optional – defaults shown) ────────────────────────────────
# Forecaster: low-latency model for repeated inference
FLAIRR_FORECASTER_MODEL=claude-haiku-4-5

# Refiner: high-capability model for meta-reasoning
FLAIRR_REFINER_MODEL=claude-sonnet-4-5

# ── Optimization hyperparameters (optional) ────────────────────────────────────
FLAIRR_MAX_ITERATIONS=5
FLAIRR_CONTEXT_LENGTH=10        # L: years of context fed to Forecaster
FLAIRR_HORIZON=3                # H: forecast horizon in years
FLAIRR_TOP_M=2                  # M: number of retrieved analogues
FLAIRR_STOP_THRESHOLD=0.05      # τ: relative MAE improvement threshold

# ── Dataset (optional – auto-downloaded if not present) ────────────────────────
OWID_DATA_PATH=energy-data-master/owid-energy-data.csv
